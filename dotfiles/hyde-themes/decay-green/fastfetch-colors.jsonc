// Deployed by theme.sh into ~/.config/fastfetch/config.jsonc. Fastfetch has
// no @import for a separate colors file (unlike alacritty.toml/rofi's
// config.rasi), so this is the *entire* themed config, not just a colors
// partial -- theme.sh replaces the whole file on every switch. Same
// module layout as dotfiles/fastfetch/config.jsonc (the Athena-derived
// default, see its own header) across all three themes; only keyColor and
// logo.color differ, using each theme's real accent palette (see that
// theme's hypr-colors.conf/rofi-colors.rasi) instead of generic ANSI
// color names, since alacritty's ANSI 16-color palette stays static
// across themes and wouldn't actually shift these on its own.
//
// Decay Green palette -- greens/gold/blue lifted from this theme's own
// hypr-colors.conf (border colors) and rofi-colors.rasi (bg-dock/fg-btn),
// same source HyDE-Project/hyde-themes branch the rest of this theme's
// files are ported from.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "arch",
    "padding": {
      "top": 0,
      "right": 3
    },
    "color": {
      "1": "#90ceaa",
      "2": "#ecd3a0"
    }
  },
  "display": {
    "separator": " : ",
    "key": {
      "width": 0
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "     󱇐 : Crafted my way."
    },
    {
      "type": "custom",
      "format": "   ╭───────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "     󰣇 OS      ",
      "keyColor": "#90ceaa"
    },
    {
      "type": "host",
      "key": "      Device  ",
      "format": "{2}",
      "keyColor": "#ecd3a0"
    },
    {
      "type": "kernel",
      "key": "      Kernel  ",
      "keyColor": "#95d3af"
    },
    {
      "type": "packages",
      "key": "     󰏖 Packages",
      "keyColor": "#93cee9"
    },
    {
      "type": "terminal",
      "key": "     󰞷 Terminal",
      "keyColor": "#86aaec"
    },
    {
      "type": "wm",
      "key": "     󱂬 WM      ",
      "keyColor": "#98d3ee"
    },
    {
      "type": "custom",
      "format": "   ╰───────────────────────────────────────╯"
    },
    "break",
    {
      "type": "title",
      "key": "     󰮚",
      "format": "{1} @ {2}"
    },
    {
      "type": "custom",
      "format": "   ╭────────────────────────────────────────────╮"
    },
    {
      "type": "cpu",
      "key": "     󰻠 CPU     ",
      "keyColor": "#90ceaa",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "     󰢮 GPU     ",
      "keyColor": "#ecd3a0",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "     󰍛 Memory  ",
      "keyColor": "#95d3af"
    },
    {
      "type": "display",
      "key": "     󰹑 Display ",
      "keyColor": "#93cee9",
      "format": "{width}x{height} @ {refresh-rate} Hz"
    },
    {
      "type": "command",
      "key": "      OS Age  ",
      "text": "birthd=$(stat -c %W /); echo $(( ( $(date +%s) - birthd ) / 86400 )) days",
      "keyColor": "#86aaec"
    },
    {
      "type": "uptime",
      "key": "     󰅐 Uptime  ",
      "keyColor": "#98d3ee"
    },
    {
      "type": "custom",
      "format": "   ╰────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 5
    },
    "break"
  ]
}
