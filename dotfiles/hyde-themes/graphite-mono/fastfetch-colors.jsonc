// Deployed by theme.sh into ~/.config/fastfetch/config.jsonc. Fastfetch has
// no @import for a separate colors file (unlike alacritty.toml/rofi's
// config.rasi), so this is the *entire* themed config, not just a colors
// partial -- theme.sh replaces the whole file on every switch. Same
// module layout as dotfiles/fastfetch/config.jsonc (the Athena-derived
// default, see its own header) across all three themes; only keyColor and
// logo.color differ, using each theme's real accent palette (see that
// theme's hypr-colors.conf/rofi-colors.rasi) instead of generic ANSI
// color names, since alacritty's ANSI 16-color palette stays static
// across themes and wouldn't actually shift these on its own.
//
// Graphite Mono palette -- deliberately monochrome (this theme has no
// real "red"/"green"/etc, just light/mid gray, see hypr-colors.conf),
// so module keyColors alternate between its two real accent grays
// (#d9d9d9/#a6a6a6) instead of faking in unrelated hues.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "arch",
    "padding": {
      "top": 0,
      "right": 3
    },
    "color": {
      "1": "#d9d9d9",
      "2": "#a6a6a6"
    }
  },
  "display": {
    "separator": " : ",
    "key": {
      "width": 0
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "     󱇐 : Crafted my way."
    },
    {
      "type": "custom",
      "format": "   ╭───────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "     󰣇 OS      ",
      "keyColor": "#d9d9d9"
    },
    {
      "type": "host",
      "key": "      Device  ",
      "format": "{2}",
      "keyColor": "#a6a6a6"
    },
    {
      "type": "kernel",
      "key": "      Kernel  ",
      "keyColor": "#d9d9d9"
    },
    {
      "type": "packages",
      "key": "     󰏖 Packages",
      "keyColor": "#a6a6a6"
    },
    {
      "type": "terminal",
      "key": "     󰞷 Terminal",
      "keyColor": "#d9d9d9"
    },
    {
      "type": "wm",
      "key": "     󱂬 WM      ",
      "keyColor": "#a6a6a6"
    },
    {
      "type": "custom",
      "format": "   ╰───────────────────────────────────────╯"
    },
    "break",
    {
      "type": "title",
      "key": "     󰮚",
      "format": "{1} @ {2}"
    },
    {
      "type": "custom",
      "format": "   ╭────────────────────────────────────────────╮"
    },
    {
      "type": "cpu",
      "key": "     󰻠 CPU     ",
      "keyColor": "#d9d9d9",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "     󰢮 GPU     ",
      "keyColor": "#a6a6a6",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "     󰍛 Memory  ",
      "keyColor": "#d9d9d9"
    },
    {
      "type": "display",
      "key": "     󰹑 Display ",
      "keyColor": "#a6a6a6",
      "format": "{width}x{height} @ {refresh-rate} Hz"
    },
    {
      "type": "command",
      "key": "      OS Age  ",
      "text": "birthd=$(stat -c %W /); echo $(( ( $(date +%s) - birthd ) / 86400 )) days",
      "keyColor": "#d9d9d9"
    },
    {
      "type": "uptime",
      "key": "     󰅐 Uptime  ",
      "keyColor": "#a6a6a6"
    },
    {
      "type": "custom",
      "format": "   ╰────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 5
    },
    "break"
  ]
}
