/* Deployed by 5-dotfiles.sh, then kept up to date by theme.sh (one copy
 * per theme under ~/.config/hyde-themes/<name>/rofi-colors.rasi) -- see
 * the README's theme switching section. This shipped copy is the
 * default theme's values (Tokyo Night), so a fresh deploy still looks
 * right even before theme.sh ever runs.
 */
* {
    bg:             rgb(26, 27, 38);
    bg-element:     rgba(255, 255, 255, 0.00);
    bg-selected:    rgb(122, 162, 247);
    bg-dock:        rgb(187, 154, 247);
    bg-btn:         rgba(41, 46, 66, 0.85);
    bg-btn-active:  rgba(192, 202, 245, 0.95);
    fg:             #594a64;
    fg-muted:       #594a64;
    fg-btn:         #a9b1d6;
    fg-btn-active:  rgba(26, 27, 38, 0.95);
    border-win:     rgba(125, 207, 255, 1.0);
    fg-prompt:      rgb(187, 154, 247);
}
