/* Deployed by 5-dotfiles.sh. Layout ported from HyDE-Project/HyDE's
 * Configs/.local/share/hyde/rofi/themes/style_10.rasi ("CompactPanel" --
 * a rounded wallpaper-thumbnail header joined to a 10-row list below
 * it), replacing the previous layout ported from Muhammad Haikal Hakim's
 * Athena (see README credits: https://github.com/haikal-hakim/athena).
 * The configuration{} block below (behavior, not style) is untouched
 * from that Athena port.
 *
 * style_10 has no mode-switcher, so filebrowser/window/run are no longer
 * reachable by clicking a button -- rofi's default Shift+Right/
 * Shift+Left (kb-mode-next/kb-mode-previous) still cycles modes from the
 * keyboard.
 *
 * __ICON_THEME__ is replaced with whatever icon theme the active theme
 * resolves to -- see theme.sh (Athena's original hardcoded "Papirus
 * cirle light", a typo'd, light-variant icon theme this repo doesn't
 * install and wouldn't suit the dark theme here anyway).
 * Dropped me-select-entry/me-accept-entry from the original -- they
 * aren't real rofi config options, and an unrecognized key can make
 * rofi discard the whole configuration block (modi included), which
 * presents as "Rofi is unsure what to show" on `-show drun`.
 */
configuration {
    modi:                "drun,filebrowser,window,run";
    show-icons:          true;
    drun-display-format: "{name}";

    display-drun:        " ";
    display-run:         " ";
    display-filebrowser: " ";
    display-window:      " ";

    hover-select:        true;
    icon-theme:          "__ICON_THEME__";

    matching:            "prefix";
    tokenize:            false;
    case-sensitive:      false;
    sort:                true;
    sorting-method:      "levenshtein";
}

/* Colors live in colors.rasi (deployed by theme.sh, one copy per theme
 * under ~/.config/hyde-themes/<name>/rofi-colors.rasi) -- see the
 * README's theme switching section. */
@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 11";
}

window {
    height:            40em;
    width:             25em;
    transparency:      "real";
    background-color:  @bg;
    border:            3px;
    border-color:      @border-win;
    border-radius:     22px;
    spacing:           0em;
    padding:           0em;
}

mainbox {
    orientation:       vertical;
    spacing:           0em;
    padding:           1em;
    background-color:  transparent;
    children:          [ "inputbar", "listbox" ];
}

/* Wallpaper thumbnail header -- wall.thmb is generated by
 * gen-wallcache.sh (this repo's stand-in for HyDE's own wallpaper-cache
 * scripts), refreshed on every wallpaper pick and every `theme.sh set`.
 * entry stays disabled, same as HyDE's original: this panel is a static
 * banner, not a search box (drun still filters as you type without one
 * visible). */
inputbar {
    enabled:           true;
    padding:           4em;
    background-color:  @bg;
    background-image:  url("~/.cache/hyde/wall.thmb", width);
    border-radius:     1em 1em 0em 0em;
    children:          [ "entry" ];
}

entry {
    enabled: false;
}

listbox {
    spacing:           0em;
    padding:           0em;
    background-color:  @bg;
    border-radius:     0em 0em 1em 1em;
    children:          [ "dummytop", "listview", "dummybottom" ];
}

listview {
    enabled:           true;
    columns:           1;
    lines:             10;
    spacing:           0.4em;
    padding:           1em;
    cycle:             true;
    dynamic:           true;
    scrollbar:         false;
    layout:            vertical;
    reverse:           false;
    expand:            false;
    fixed-height:      true;
    fixed-columns:     true;
    cursor:            "default";
    background-color:  @bg;
    text-color:        @fg;
}

dummytop {
    background-color: @bg;
}

dummybottom {
    background-color: @bg;
    border-radius:     0em 0em 1em 1em;
}

element {
    enabled:           true;
    spacing:           1em;
    padding:           0.2em 0.2em 0.2em 1.5em;
    cursor:            pointer;
    background-color:  transparent;
    text-color:        @fg;
    children:          [ element-icon, element-text ];
}

element selected.normal {
    background-color: @bg-selected;
}

element-icon {
    background-color: transparent;
    size:             2em;
    cursor:            inherit;
    text-color:        inherit;
    horizontal-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color:       @fg-muted;
    vertical-align:   0.5;
    horizontal-align: 0.0;
    font:             "JetBrainsMono Nerd Font 11";
}

element selected.normal element-text {
    text-color: @fg;
}

element-text highlight {
    text-color: @fg;
}
