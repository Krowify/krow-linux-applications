{
  // Native waybar module (talks to MPRIS over D-Bus directly, no
  // playerctl dependency) -- added for the right-side layout (see
  // https://github.com/00Darxk/dotfiles's waybar).
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "player-icons": {
      "default": "▶",
      "spotify": ""
    },
    "status-icons": {
      "paused": ""
    },
    "max-length": 40
  }
}
